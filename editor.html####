<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Writer | English Materials</title>
<link rel="icon" type="image/png" href="https://raw.githubusercontent.com/abubokkorshiddik/Eng-materials/main/10719400.png">
<meta name="theme-color" content="#1f4fbf">
<meta name="description" content="A free online word processor. Write, format, add tables and pictures, then download as Word or print as PDF.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@500;600&family=Lora:wght@400;700&family=Merriweather:wght@400;700&family=Open+Sans:wght@400;700&family=Roboto:wght@400;700&family=Source+Code+Pro:wght@400&family=Noto+Sans+Bengali:wght@400;700&family=Hind+Siliguri:wght@400;700&display=swap" rel="stylesheet">
<script>
try {
  var st = JSON.parse(localStorage.getItem('ielts-gl-reader') || '{}');
  document.documentElement.dataset.theme = st.theme || localStorage.getItem('theme') || 'light';
} catch (e) {}
</script>
<style>
:root { --bar:#fff; --glass:rgba(255,255,255,.92); --bg2:#f7f7f7; --onacc:#fff; --bg:#e6e6e6; --text:#242424; --line:#0002; --accent:#185abd; --soft:#185abd18; }
html[data-theme="sepia"] { --bar:#efe5cc; --glass:rgba(239,229,204,.94); --bg2:#e6d9bb; --onacc:#fff8e8; --bg:#d9cba8; --text:#4a3b26; --line:#4a3b2633; --accent:#8a4b12; --soft:#8a4b1220; }
html[data-theme="dark"] { --bar:#1b1f29; --glass:rgba(27,31,41,.94); --bg2:#252a38; --onacc:#10131a; --bg:#10131a; --text:#e6e6e6; --line:#fff3; --accent:#8fb0ff; --soft:#8fb0ff22; }
* { box-sizing:border-box; }
html { -webkit-text-size-adjust:100%; }
body { margin:0; background:var(--bg); color:var(--text); font:600 14px Inter, system-ui, sans-serif; height:100vh; height:100dvh; display:flex; flex-direction:column; overflow:hidden; }
:focus-visible { outline:3px solid var(--accent); outline-offset:1px; }
[hidden] { display:none !important; }
button, select, input { font:inherit; color:var(--text); }
svg { display:block; pointer-events:none; }

/* Title bar */
.top { display:flex; align-items:center; gap:6px; padding:4px 10px; padding-top:calc(4px + env(safe-area-inset-top,0px)); background:#185abd; color:#fff; flex:none; }
html[data-theme="dark"] .top { background:#143a73; }
html[data-theme="sepia"] .top { background:#8a4b12; }
.top a, .top button { color:#fff; background:none; border:0; border-radius:6px; width:34px; height:34px; display:inline-flex; align-items:center; justify-content:center; cursor:pointer; text-decoration:none; flex:none; }
.top a:hover, .top button:hover { background:#fff3; }
.app { font-weight:700; font-size:15px; margin:0 8px 0 2px; }
.top .as { width:auto; height:30px; padding:0 8px; gap:6px; font-size:12px; }
.sl { width:34px; height:18px; border-radius:9px; background:#fff3; border:1px solid #fffa; position:relative; flex:none; }
.sl i { position:absolute; top:2px; left:2px; width:12px; height:12px; border-radius:50%; background:#fff; transition:left .15s; }
.as[aria-checked="true"] .sl { background:#fff; }
.as[aria-checked="true"] .sl i { left:18px; background:#185abd; }
#dname { width:min(30vw,240px); min-width:90px; background:transparent; border:1px solid transparent; border-radius:6px; color:#fff; padding:5px 8px; font-size:13px; font-weight:600; }
#dname:hover, #dname:focus { border-color:#fff7; background:#fff2; }
#sstat { font-size:11px; opacity:.85; white-space:nowrap; font-weight:500; flex:none; }
#tsearch { flex:1; max-width:420px; margin:0 auto; min-width:60px; height:30px; border-radius:6px; border:0; background:rgba(255,255,255,.95); color:#222; padding:0 12px; font-weight:500; }
.top .sp { flex:1; }
@media (max-width:760px) { .at, .app { display:none; } #tsearch { display:none; } .top .sp { display:block; } }

/* Tabs and ribbon */
.tabs { display:flex; gap:2px; padding:4px 8px 0; background:var(--bar); border-bottom:1px solid var(--line); overflow-x:auto; flex:none; scrollbar-width:none; }
.tabs::-webkit-scrollbar { display:none; }
.tab { border:0; background:none; padding:8px 14px; border-radius:8px 8px 0 0; cursor:pointer; font-size:13px; white-space:nowrap; }
.tab:hover { background:var(--soft); }
.tab[aria-selected="true"] { background:none; color:var(--accent); box-shadow:inset 0 -2px 0 var(--accent); border-radius:0; }
.tab.file { margin-right:4px; }
.ribbon { background:var(--bg2); border-bottom:1px solid var(--line); flex:none; overflow-x:auto; scrollbar-width:thin; }
.panel { display:flex; align-items:stretch; padding:6px 8px; gap:0; min-width:max-content; }
.grp { display:flex; flex-direction:column; justify-content:space-between; padding:0 8px; border-right:1px solid var(--line); }
.grp:last-child { border-right:0; }
.grp .rows { display:flex; flex-direction:column; gap:3px; }
.grp .row { display:flex; gap:2px; align-items:center; }
.grp .gl { text-align:center; font-size:10.5px; opacity:.65; margin-top:3px; font-weight:600; }
.rb { min-width:32px; height:30px; border:0; background:none; border-radius:6px; display:inline-flex; align-items:center; justify-content:center; gap:4px; cursor:pointer; padding:0 6px; flex:none; font-size:14px; }
.rb:hover { background:var(--line); }
.rb.on, .rb[aria-pressed="true"] { background:var(--accent); color:var(--onacc); }
.rb.big { flex-direction:column; height:62px; min-width:54px; font-size:11px; gap:3px; }
.rb.sty { min-width:64px; height:46px; border:1px solid var(--line); background:var(--bar); flex-direction:column; font-size:11px; margin-right:3px; }
.rb.sty span { font-size:15px; line-height:1.1; }
select.rs, input.rs { height:30px; border:1px solid var(--line); background:var(--bar); border-radius:6px; padding:0 6px; cursor:pointer; }
#ffam { width:130px; } #fsz { width:62px; }
.ar::after { content:""; border:4px solid transparent; border-top-color:currentColor; border-bottom:0; margin-left:2px; }
.cbar { display:block; width:14px; height:3px; border-radius:1px; margin-top:1px; }

/* Floating menu */
#menu { position:fixed; z-index:60; background:var(--bar); border:1px solid var(--line); border-radius:10px; box-shadow:0 10px 30px #0004; padding:6px; min-width:150px; max-height:70vh; overflow:auto; }
#menu button.mi { display:flex; width:100%; align-items:center; gap:8px; text-align:left; border:0; background:none; padding:8px 10px; border-radius:6px; cursor:pointer; }
#menu button.mi:hover { background:var(--soft); }
#menu .pal { display:grid; grid-template-columns:repeat(8,24px); gap:4px; padding:4px; }
#menu .pal button { width:24px; height:24px; border-radius:4px; border:1px solid var(--line); cursor:pointer; padding:0; }
#menu .tg { display:grid; grid-template-columns:repeat(8,20px); gap:2px; padding:4px; }
#menu .tg i { width:20px; height:20px; border:1px solid var(--line); border-radius:2px; background:var(--bar); }
#menu .tg i.on { background:var(--accent); border-color:var(--accent); }
#menu .tl { text-align:center; font-size:12px; padding:2px; opacity:.8; }
#menu .sym { display:grid; grid-template-columns:repeat(8,32px); gap:2px; }
#menu .sym button { width:32px; height:32px; border:0; background:none; border-radius:6px; cursor:pointer; font-size:17px; }
#menu .sym button:hover { background:var(--soft); }

/* Workspace */
#work { flex:1; min-height:0; overflow:auto; position:relative; padding:12px 8px 40px; -webkit-overflow-scrolling:touch; }
#zoomer { width:max-content; margin:0 auto; transform-origin:top center; }
#ruler { height:20px; margin:0 auto 8px; background:var(--bar); border:1px solid var(--line); border-radius:3px; position:relative; overflow:hidden; opacity:.9; }
#ruler .tk { position:absolute; inset:0; background:
  repeating-linear-gradient(90deg, var(--text) 0 1px, transparent 1px 96px) 0 100%/100% 12px no-repeat,
  repeating-linear-gradient(90deg, var(--text) 0 1px, transparent 1px 48px) 0 100%/100% 8px no-repeat,
  repeating-linear-gradient(90deg, var(--text) 0 1px, transparent 1px 12px) 0 100%/100% 4px no-repeat; opacity:.45; }
#ruler .mg { position:absolute; top:0; bottom:0; background:var(--line); }
#paper { background:var(--pc,#fff); color:#111; box-shadow:0 2px 10px #0004; margin:0 auto; position:relative;
  background-image:repeating-linear-gradient(to bottom, var(--pc,#fff) 0, var(--pc,#fff) calc(var(--ph) - 8px), #cfcdc7 calc(var(--ph) - 8px), #cfcdc7 var(--ph)); }
#doc .cmt { background:#fff1b8; border-bottom:2px solid #f0b400; }
#doc .cmt.fl { outline:2px solid #f0b400; }
#doc ins.trk { color:#c62828; text-decoration:underline; }
#doc del.trk { color:#c62828; text-decoration:line-through; }
#doc .toc { border:1px solid #ddd; padding:10px 16px; margin:10px 0; background:#fafafa; }
#doc .toc p { margin:0 0 4px; }
#doc .toc .tl { display:flex; align-items:baseline; }
#doc .toc .dots { flex:1; border-bottom:1px dotted #777; margin:0 6px 4px; }
#doc .fnline { width:30%; margin:24px 0 6px 0; }
#doc .fnotes p { font-size:13px; margin:0 0 3px; }
#doc .cap { font-size:13px; color:#44546a; }
#doc sup.fn { color:#185abd; }
#cpane { position:fixed; right:0; top:var(--pt,170px); bottom:30px; width:min(92vw,280px); background:var(--bar); border-left:1px solid var(--line); z-index:30; overflow:auto; padding:10px; box-shadow:-4px 0 14px #0002; }
#cpane .ch { display:flex; align-items:center; gap:6px; margin-bottom:6px; } #cpane .ch b { flex:1; font-size:15px; }
#cpane textarea { width:100%; min-height:70px; border:1px solid var(--line); border-radius:6px; padding:8px; background:var(--bg2); font:500 13px Inter, sans-serif; }
#cpane .cc { margin:8px 0; display:flex; flex-direction:column; gap:6px; }
#cpane .ci { border:1px solid var(--line); border-left:4px solid #f0b400; border-radius:8px; padding:8px 10px; margin:8px 0; cursor:pointer; font-weight:500; font-size:13px; }
#cpane .ci small { display:block; opacity:.65; margin-bottom:3px; } #cpane .ci q { display:block; opacity:.7; margin:2px 0 4px; font-style:italic; } #cpane .cn { opacity:.7; font-weight:500; font-size:13px; }
#dlg { position:fixed; inset:0; background:#0006; z-index:95; display:flex; align-items:center; justify-content:center; padding:16px; }
.dbx { background:var(--bar); border:1px solid var(--line); border-radius:12px; padding:18px; width:min(100%,340px); }
.dbx h3 { margin:0 0 10px; font-size:16px; } .dbx table { width:100%; border-collapse:collapse; } .dbx td { padding:5px 0; font-weight:500; } .dbx td:last-child { text-align:right; font-weight:700; }
.dact { text-align:right; margin-top:12px; }
.dbx { max-height:90vh; overflow:auto; } .dbx.wide { width:min(100%,560px); }
.fin { display:block; width:100%; margin:0 0 8px; border:1px solid var(--line); background:var(--bg2); color:var(--text); border-radius:6px; padding:8px; font:500 13px Inter, sans-serif; }
.two { display:flex; gap:6px; } .two .fin { min-width:0; }
.srclist { max-height:46vh; overflow:auto; margin:8px 0; }
.srow2 { display:flex; gap:6px; align-items:center; border-top:1px solid var(--line); padding:6px 0; }
.srow2 > div { flex:1; min-width:0; font-weight:500; font-size:13px; } .srow2 small { display:block; opacity:.65; }
.srcbtn { display:flex; gap:6px; flex-wrap:wrap; }
.chk2 { display:flex; gap:8px; align-items:center; font-weight:500; margin:4px 0 10px; }
#doc .cite { background:#e8f0fe; border-radius:3px; }
#doc .bibl { margin:12px 0; }
#doc { outline:none; min-height:100px; font:400 16px/1.5 Calibri, Carlito, "Open Sans", Arial, sans-serif; word-wrap:break-word; overflow-wrap:anywhere; }
#doc p, #doc div { margin:0 0 8px; }
#doc h1 { font-size:28px; margin:18px 0 8px; } #doc h2 { font-size:22px; margin:16px 0 6px; } #doc h3 { font-size:18px; margin:14px 0 6px; }
#doc blockquote { margin:10px 24px; padding:4px 14px; border-left:4px solid #bbb; color:#555; font-style:italic; }
#doc .ttl { font-size:38px; font-weight:400; text-align:center; letter-spacing:.5px; margin:0 0 14px; }
#doc table { border-collapse:collapse; margin:8px 0; width:100%; table-layout:fixed; }
#doc td, #doc th { border:1px solid #777; padding:5px 8px; vertical-align:top; min-width:30px; }
#doc img { max-width:100%; height:auto; cursor:pointer; }
#doc img.sel { outline:3px solid var(--accent); }
#doc hr { border:0; border-top:1px solid #777; margin:12px 0; }
#doc hr.pagebreak { border-top:2px dashed #999; position:relative; margin:18px 0; break-after:page; page-break-after:always; }
#doc hr.pagebreak::after { content:"Page break"; position:absolute; left:50%; top:-9px; transform:translateX(-50%); background:#fff; padding:0 8px; font:600 11px Inter, sans-serif; color:#888; }
#doc a { color:#1f4fbf; }
#doc mark.fm { background:#ffd54a; }
#doc ::selection { background:rgba(40,110,255,.3); }
#doc .pgsp { margin:0 !important; padding:0; border:0; user-select:none; -webkit-user-select:none; pointer-events:none; }
#hf { position:absolute; inset:0; pointer-events:none; user-select:none; -webkit-user-select:none; font:500 12px Calibri, "Open Sans", Arial, sans-serif; color:#777; overflow:hidden; }
#hf div { position:absolute; display:flex; justify-content:space-between; gap:12px; white-space:nowrap; overflow:hidden; line-height:18px; }
::highlight(wfind) { background:#ffe14d; color:#000; }
::highlight(wcur) { background:#ff9632; color:#000; }
#doc.fp { cursor:copy; }
.tabs .tog { margin-left:auto; padding:8px 12px; font-size:15px; }
.ribbon.off { display:none; }
#find .fo { display:flex; gap:14px; flex-wrap:wrap; margin:2px 0 8px; font-weight:500; font-size:12px; }
#find .fo label { display:flex; align-items:center; gap:6px; cursor:pointer; }
#find .fo input { width:auto; height:auto; margin:0; }
#npane { position:fixed; left:0; top:var(--pt,170px); bottom:30px; width:min(86vw,250px); background:var(--bar); border-right:1px solid var(--line); z-index:30; overflow:auto; padding:10px; box-shadow:4px 0 14px #0002; }
#npane .ch { display:flex; align-items:center; gap:6px; margin-bottom:6px; } #npane .ch b { flex:1; font-size:15px; }
#npane button.ni { display:block; width:100%; text-align:left; border:0; background:none; padding:6px 8px; border-radius:6px; cursor:pointer; font-weight:500; font-size:13px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
#npane button.ni:hover { background:var(--soft); }
#npane .cn { opacity:.7; font-weight:500; font-size:13px; }
#rsz { position:fixed; z-index:41; width:14px; height:14px; background:var(--accent); border:2px solid #fff; border-radius:3px; cursor:nwse-resize; touch-action:none; }

/* Context toolbar (tables, images) */
#ctx { position:fixed; z-index:40; display:flex; gap:2px; flex-wrap:wrap; max-width:94vw; background:var(--bar); border:1px solid var(--line); border-radius:10px; box-shadow:0 6px 20px #0004; padding:4px; }
#ctx button { border:0; background:none; border-radius:6px; padding:6px 9px; cursor:pointer; font-size:12px; white-space:nowrap; }
#ctx button:hover { background:var(--soft); }
#ctx .x { color:#d33; }

/* Status bar */
.status { display:flex; align-items:center; gap:14px; padding:4px 12px; padding-bottom:calc(4px + env(safe-area-inset-bottom,0px)); background:var(--bar); color:var(--text); border-top:1px solid var(--line); font-size:12px; flex:none; font-weight:500; }
.status .sp { flex:1; }
.status button { background:none; border:0; color:var(--text); cursor:pointer; width:24px; height:24px; border-radius:50%; font-size:16px; line-height:1; }
.status button:hover { background:var(--line); }
#zr { width:110px; accent-color:var(--accent); }
.status .hide-s { }
@media (max-width:640px) { .hide-s { display:none; } #zr { width:70px; } }

/* Find panel */
#find { position:fixed; right:12px; top:calc(var(--ft,120px)); z-index:50; width:min(330px,94vw); background:var(--bar); border:1px solid var(--line); border-radius:12px; box-shadow:0 10px 30px #0005; padding:12px; }
#find input { width:100%; height:34px; border:1px solid var(--line); background:var(--bg); border-radius:6px; padding:0 10px; margin-bottom:6px; }
#find .fr { display:flex; gap:6px; flex-wrap:wrap; margin-top:2px; }
.btn { border:1px solid var(--line); background:none; border-radius:8px; padding:7px 12px; cursor:pointer; min-height:34px; display:inline-flex; align-items:center; gap:6px; text-decoration:none; color:var(--text); }
.btn:hover { background:var(--soft); }
.btn.pri { background:var(--accent); color:var(--onacc); border-color:var(--accent); }
#fmsg { font-size:12px; opacity:.75; margin:6px 0 0; font-weight:500; }

/* File drawer */
#back { position:fixed; inset:0; background:#0006; z-index:70; }
#file { position:fixed; top:0; bottom:0; left:0; width:min(92vw,380px); background:var(--bar); z-index:71; box-shadow:2px 0 16px #0004; display:flex; flex-direction:column; padding-top:env(safe-area-inset-top,0px); }
#file .fh { display:flex; align-items:center; justify-content:space-between; padding:10px 12px 10px 16px; font-size:16px; border-bottom:1px solid var(--line); }
#file .fb { overflow:auto; padding:8px 12px 24px; flex:1; }
.fi { display:flex; align-items:center; gap:12px; width:100%; text-align:left; border:0; background:none; padding:12px 8px; border-radius:8px; cursor:pointer; text-decoration:none; color:var(--text); }
.fi:hover { background:var(--soft); }
.fi small { display:block; opacity:.65; font-weight:500; font-size:11px; }
.fsh { margin:16px 6px 4px; font-size:12px; opacity:.65; }
.drow { display:flex; align-items:center; border-top:1px solid var(--line); }
.drow button.o { flex:1; text-align:left; background:none; border:0; padding:10px 6px; cursor:pointer; min-width:0; }
.drow button.o small { display:block; opacity:.65; font-weight:500; font-size:11px; }
.drow button.d { background:none; border:0; cursor:pointer; padding:8px; opacity:.7; }
#toast { position:fixed; left:50%; bottom:calc(52px + env(safe-area-inset-bottom,0px)); transform:translateX(-50%); background:var(--bar); border:1px solid var(--line); border-radius:999px; padding:7px 16px; font-size:12px; box-shadow:0 4px 14px #0004; z-index:90; opacity:0; pointer-events:none; transition:opacity .2s; }
#toast.show { opacity:1; }

@media print {
  body { display:block; height:auto; overflow:visible; background:#fff; }
  .top, .tabs, .ribbon, .status, #ruler, #ctx, #find, #menu, #file, #back, #toast, #cpane, #npane, #rsz, #hf, #dlg, #doc .pgsp { display:none !important; }
  #work { overflow:visible; padding:0 !important; }
  #zoomer { zoom:1 !important; }
  #paper { box-shadow:none; margin:0; background:#fff !important; background-image:none !important; width:auto !important; min-height:0 !important; padding:0 !important; outline:none !important; }
  #doc .cmt { background:none; border:0; } #doc .cite, #doc .toc { background:none; }
}
</style>
</head>
<body>

<div class="top">
  <a href="./index.html" aria-label="Home" data-i="home"></a>
  <span class="app">Word</span>
  <button class="as" id="asBtn" type="button" role="switch" aria-checked="true" aria-label="AutoSave"><span class="sl"><i></i></span><span class="at">AutoSave</span></button>
  <input id="dname" type="text" value="Untitled document" aria-label="Document name" maxlength="80" spellcheck="false">
  <span id="sstat">Saved</span>
  <input id="tsearch" type="search" placeholder="Search" aria-label="Search the document">
  <span class="sp"></span>
  <button id="cmBtn" type="button" aria-label="Comments" title="Comments" data-i="comment"></button>
  <button id="themeBtn" type="button" aria-label="Change theme" data-i="sun"></button>
</div>

<nav class="tabs" role="tablist" aria-label="Ribbon tabs">
  <button class="tab file" id="fileBtn" type="button">File</button>
  <button class="tab" role="tab" data-tab="home" aria-selected="true">Home</button>
  <button class="tab" role="tab" data-tab="insert" aria-selected="false">Insert</button>
  <button class="tab" role="tab" data-tab="design" aria-selected="false">Design</button>
  <button class="tab" role="tab" data-tab="layout" aria-selected="false">Layout</button>
  <button class="tab" role="tab" data-tab="refs" aria-selected="false">References</button>
  <button class="tab" role="tab" data-tab="review" aria-selected="false">Review</button>
  <button class="tab" role="tab" data-tab="view" aria-selected="false">View</button>
  <button class="tab tog" id="ribToggle" type="button" aria-label="Collapse the ribbon" aria-expanded="true" title="Collapse or expand the ribbon (double-click a tab)">⌃</button>
</nav>

<div class="ribbon" id="ribbon">
  <!-- HOME -->
  <div class="panel" data-panel="home">
    <div class="grp">
      <div class="row">
        <button class="rb big" type="button" data-act="paste" data-i="paste" data-s="22">Paste</button>
        <div class="rows">
          <button class="rb" type="button" data-act="cut" data-i="cut" aria-label="Cut" title="Cut (Ctrl+X)"></button>
          <button class="rb" type="button" data-act="copy" data-i="copy" aria-label="Copy" title="Copy (Ctrl+C)"></button>
        </div>
        <div class="rows">
          <button class="rb" type="button" data-cmd="undo" data-i="undo" aria-label="Undo" title="Undo (Ctrl+Z)"></button>
          <button class="rb" type="button" data-cmd="redo" data-i="redo" aria-label="Redo" title="Redo (Ctrl+Y)"></button>
        </div>
        <div class="rows">
          <button class="rb" type="button" data-act="fpaint" data-i="brush" aria-label="Format Painter" title="Format Painter: copy formatting from one place to another"></button>
        </div>
      </div>
      <div class="gl">Clipboard</div>
