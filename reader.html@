<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Reader | English Materials</title>
<link rel="icon" type="image/png" href="https://raw.githubusercontent.com/abubokkorshiddik/Eng-materials/main/10719400.png">
<meta name="theme-color" content="#1f2a44">
<meta name="description" content="Read English grammar books, IELTS practice tests, vocabulary guides and classic literature online. Highlight, draw, add comments and flip pages like a real book.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@500;600&display=swap" rel="stylesheet">
<script>
try {
  var settings = JSON.parse(localStorage.getItem('ielts-gl-reader') || '{}');
  document.documentElement.dataset.theme = settings.theme || localStorage.getItem('theme') || 'light';
} catch (e) {}
</script>
<style>
:root { --bar:#fff; --glass:rgba(255,255,255,.9); --bg2:#f1efe9; --onacc:#fff; --bg:#e9e7e2; --text:#222; --line:#0002; --accent:#1f4fbf; --filter:none; }
html[data-theme="sepia"] { --bar:#efe5cc; --glass:rgba(239,229,204,.92); --bg2:#e6d9bb; --onacc:#fff8e8; --bg:#e3d6b8; --text:#4a3b26; --line:#4a3b2633; --accent:#8a4b12; --filter:sepia(.5) saturate(.9) brightness(.97); }
html[data-theme="dark"] { --bar:#1b1f29; --glass:rgba(27,31,41,.92); --bg2:#252a38; --onacc:#10131a; --bg:#10131a; --text:#e6e6e6; --line:#fff3; --accent:#8fb0ff; --filter:invert(1) hue-rotate(180deg) brightness(.92); }
* { box-sizing:border-box; }
html { -webkit-text-size-adjust:100%; text-size-adjust:100%; }
body { margin:0; background:var(--bg); color:var(--text); font:600 14px Inter, system-ui, sans-serif;
  padding-left:env(safe-area-inset-left,0px); padding-right:env(safe-area-inset-right,0px); }
:focus-visible { outline:3px solid var(--accent); outline-offset:2px; }
[hidden] { display:none !important; }
button { font:inherit; color:var(--text); }
svg { display:block; pointer-events:none; }

/* ---------- Glass surfaces ---------- */
.bar, .dock, #opts, #sel { backdrop-filter:blur(14px) saturate(1.2); -webkit-backdrop-filter:blur(14px) saturate(1.2); }

/* ---------- Top bar + tool rail ---------- */
.bar { position:fixed; left:0; right:0; top:0; z-index:10; display:flex; flex-wrap:wrap; align-items:center; gap:2px 4px; background:var(--glass);
  border-bottom:1px solid var(--line); padding:4px 8px; padding-top:calc(4px + env(safe-area-inset-top,0px)); transition:transform .25s ease; }
body.chromeOff .bar { transform:translateY(-110%); }
.ib { position:relative; color:var(--text); background:none; border:0; border-radius:10px; width:40px; height:40px; text-decoration:none;
  display:inline-flex; align-items:center; justify-content:center; cursor:pointer; flex:none; }
.ib:hover { background:var(--line); }
.title { flex:1 1 60px; min-width:0; font-size:14px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; text-align:center; padding:0 4px; }
#cnt { position:absolute; top:2px; right:0; background:var(--accent); color:var(--onacc); border-radius:99px; padding:0 5px; font-size:10px; line-height:15px; }
#progress { position:absolute; left:0; right:0; bottom:-1px; height:3px; }
#progressBar { height:100%; width:0; background:var(--accent); transition:width .15s; }
.brk { display:none; flex-basis:100%; height:0; order:9; }

.rail { display:flex; gap:2px; padding:3px; background:var(--bg2); border:1px solid var(--line); border-radius:15px; flex:none; order:5; }
.rail button { position:relative; width:42px; height:38px; border:0; background:none; border-radius:12px; display:grid; place-items:center; cursor:pointer;
  color:var(--text); transition:background .15s, transform .1s; }
.rail button:hover { background:var(--line); }
.rail button:active { transform:scale(.92); }
.rail button[aria-pressed="true"] { background:var(--accent); color:var(--onacc); box-shadow:0 2px 8px #0003; }
.rail .dot { position:absolute; bottom:3px; left:50%; width:16px; height:3px; margin-left:-8px; border-radius:2px; display:none; box-shadow:0 0 0 1px #0003; }
.rail button.hasdot .dot { display:block; }
.rsep { width:1px; margin:6px 2px; background:var(--line); }
.title { order:3; } #searchBtn { order:5; } #notesBtn { order:6; } #setBtn { order:7; }
@media (max-width:640px) {
  .brk { display:block; }
  .title { order:3; }
  .rail { order:10; margin:2px auto 4px; }
  #searchBtn { order:4; } #notesBtn { order:4; } #setBtn { order:5; }
}

/* ---------- Tool options popover (below top bar) ---------- */
#opts { position:fixed; left:50%; top:calc(var(--top,96px) + 8px); transform:translateX(-50%); z-index:11; display:flex; gap:8px; align-items:center;
  flex-wrap:wrap; justify-content:center; max-width:94vw; background:var(--glass); border:1px solid var(--line); border-radius:16px;
  padding:8px 12px; box-shadow:0 8px 24px #0003; transition:transform .25s, opacity .25s; }
body.chromeOff #opts { transform:translate(-50%,-220%); opacity:0; pointer-events:none; }
#opts .sw { width:26px; height:26px; border-radius:50%; border:2px solid var(--line); cursor:pointer; padding:0; background-clip:padding-box; }
#opts .sw.on { border-color:var(--text); transform:scale(1.15); }
#opts .pv { width:30px; height:30px; display:grid; place-items:center; }
#opts .pv i { display:block; border-radius:50%; max-width:28px; max-height:28px; }
#opts .sepv { width:1px; height:24px; background:var(--line); }
#opts input[type=range] { width:90px; accent-color:var(--accent); }
#opts button.u { border:1px solid var(--line); background:none; border-radius:10px; width:36px; height:34px; display:grid; place-items:center; cursor:pointer; }
.hint { font-weight:500; opacity:.8; line-height:1.6; }

/* ---------- Scroll mode ---------- */
#pages { display:flex; flex-direction:column; gap:12px; padding:calc(var(--top,96px) + 10px) 0 calc(var(--bot,100px) + 40px); }
#pages.two { display:grid; grid-template-columns:repeat(2,max-content); justify-content:center; }
.pg { position:relative; flex:none; margin:0 auto; background:#fff; box-shadow:0 1px 6px #0003; overflow:hidden; touch-action:manipulation; }
.pg canvas { display:block; width:100%; height:auto; filter:var(--filter); }
.pg.empty { background:var(--bar); }
.pg.blank { background:transparent; box-shadow:none; }
#msg { text-align:center; padding:120px 16px 40px; line-height:1.8; }
#msg a { color:var(--accent); }

.textLayer { position:absolute; inset:0; overflow:hidden; line-height:1; text-size-adjust:none; }
.textLayer span, .textLayer br { color:transparent; position:absolute; white-space:pre; cursor:text; transform-origin:0 0; }
.textLayer ::selection { background:rgba(40,110,255,.35); }
.hl { position:absolute; inset:0; pointer-events:none; }
.hl i { position:absolute; opacity:.4; border-radius:2px; }
.hl i.has { box-shadow:inset 0 -2px 0 #0008; }
.ink { position:absolute; inset:0; width:100%; height:100%; pointer-events:none; }
.pins { position:absolute; inset:0; pointer-events:none; }
.pin { position:absolute; transform:translate(-50%,-100%); pointer-events:auto; width:28px; height:28px; border:2px solid #0006; background:#ffd93d;
  border-radius:50% 50% 50% 4px; font-size:14px; line-height:1; cursor:pointer; padding:0; box-shadow:0 2px 6px #0004; }
.rib { position:absolute; top:0; right:0; width:0; height:0; border-top:20px solid #d6336c; border-left:20px solid transparent; opacity:.85; }

body.draw .pg { touch-action:none; cursor:crosshair; }
body.draw .textLayer { pointer-events:none; user-select:none; -webkit-user-select:none; }
body.pinmode .pg { cursor:copy; }

#pill { position:fixed; left:50%; bottom:calc(56px + env(safe-area-inset-bottom,0px)); transform:translateX(-50%);
  background:var(--bar); border:1px solid var(--line); border-radius:999px; padding:6px 14px; font-size:12px;
  box-shadow:0 2px 8px #0003; opacity:0; pointer-events:none; transition:opacity .2s; z-index:13; }
#pill.show { opacity:.95; }

/* ---------- Book mode ---------- */
#book { position:fixed; inset:0; z-index:1; display:flex; overflow:hidden;
  padding:calc(var(--top,96px) + 8px) 8px calc(var(--bot,90px) + 4px); touch-action:pan-y pinch-zoom; }
#book.zoomed { overflow:auto; touch-action:pan-x pan-y pinch-zoom; -webkit-overflow-scrolling:touch; }
body.draw #book { touch-action:none; }
.holder { position:relative; perspective:2000px; margin:auto; flex:none; }
.holder.two::after { content:""; position:absolute; left:50%; top:0; bottom:0; width:40px; margin-left:-20px; pointer-events:none; z-index:4;
  background:linear-gradient(90deg,transparent,rgba(0,0,0,.2) 50%,transparent); }
.stage { position:absolute; left:0; top:0; width:100%; height:100%; transform-style:preserve-3d; }
.slot { position:absolute; top:0; }
.slot .pg, .face .pg { margin:0; }
.leaf { position:absolute; top:0; transform-style:preserve-3d; will-change:transform; pointer-events:none; }
.face { position:absolute; inset:0; backface-visibility:hidden; -webkit-backface-visibility:hidden; }
.face.back { transform:rotateY(180deg); }
.face::after { content:""; position:absolute; inset:0; pointer-events:none; background:linear-gradient(90deg,rgba(0,0,0,.45),transparent 80%); opacity:var(--s,0); }
.face.back::after { background:linear-gradient(270deg,rgba(0,0,0,.45),transparent 80%); }

.edge { position:fixed; top:50%; transform:translateY(-50%); z-index:8; width:34px; height:64px; border-radius:12px; border:1px solid var(--line);
  background:var(--glass); display:none; place-items:center; opacity:.65; cursor:pointer; }
.edge:hover { opacity:1; }
.edge.l { left:4px; } .edge.r { right:4px; }
body.bookmode .edge { display:grid; }
@media (pointer:coarse) { .edge { display:none !important; } }

/* ---------- Selection toolbar ---------- */
#sel { position:fixed; left:50%; bottom:calc(var(--bot,100px) + 8px); transform:translateX(-50%);
  display:none; gap:6px; align-items:center; background:var(--glass); border:1px solid var(--line);
  border-radius:14px; padding:8px; box-shadow:0 6px 20px #0004; z-index:25; max-width:96vw; }
#sel.show { display:flex; }
#sel button { color:var(--text); background:none; border:1px solid var(--line); border-radius:10px; padding:7px 11px; font:inherit; min-height:36px; cursor:pointer;
  display:inline-flex; align-items:center; gap:6px; }
#sel .sw { width:32px; height:32px; border-radius:50%; padding:0; border:2px solid var(--line); cursor:pointer; background-clip:padding-box; }

/* ---------- Minimal bottom controls ---------- */
.dock { position:fixed; left:0; right:0; bottom:calc(8px + env(safe-area-inset-bottom,0px)); z-index:12; height:34px; display:flex; align-items:center;
  justify-content:space-between; padding:0 12px; pointer-events:none; transition:transform .25s ease, opacity .25s; }
body.chromeOff .dock { transform:translateY(200%); opacity:0; }
.dock > * { pointer-events:auto; }
.dock .n { width:34px; height:34px; border-radius:50%; border:1px solid var(--line); background:var(--glass); display:grid; place-items:center; cursor:pointer; padding:0; opacity:.75; }
.dock .n:hover { opacity:1; }
#pgn { background:none; border:0; font:inherit; font-size:12px; opacity:.6; cursor:pointer; padding:6px 10px; border-radius:99px; }

/* ---------- Dictionary card, resume banner, search ---------- */
#dict { position:fixed; left:50%; transform:translateX(-50%); bottom:calc(52px + env(safe-area-inset-bottom,0px)); width:min(460px,94vw); max-height:55vh; overflow:auto;
  z-index:26; background:var(--bar); border:1px solid var(--line); border-radius:16px; box-shadow:0 10px 30px #0005; padding:10px 14px 12px; font-weight:500; }
#dict .dh { display:flex; align-items:center; gap:6px; }
#dict .dw { font-size:19px; } #dict .dph { opacity:.7; flex:1; }
#dict .dm { margin-top:8px; } #dict .dm i { opacity:.65; font-size:12px; }
#dict .dd { margin:3px 0 0; line-height:1.5; } #dict .dex { opacity:.7; font-size:13px; margin-top:2px; }
#dict .dfoot { display:flex; gap:6px; margin-top:12px; flex-wrap:wrap; }
#resume { position:fixed; left:50%; top:calc(var(--top,96px) + 8px); transform:translateX(-50%); z-index:11; display:flex; align-items:center; gap:8px; background:var(--glass);
  backdrop-filter:blur(14px); -webkit-backdrop-filter:blur(14px); border:1px solid var(--line); border-radius:999px; padding:6px 8px 6px 14px; box-shadow:0 6px 20px #0003; font-weight:500; font-size:13px; max-width:94vw; }
#resume button { border:1px solid var(--line); background:none; border-radius:999px; padding:6px 12px; cursor:pointer; font:inherit; font-size:13px; }
#resume #rYes { background:var(--accent); color:var(--onacc); border-color:var(--accent); }
#dBody mark { background:#ffd54a; color:#000; border-radius:2px; padding:0 1px; }
.textLayer span.sm { background:rgba(255,160,0,.5); border-radius:2px; }

/* ---------- Eye comfort overlays ---------- */
#dim, #warm { position:fixed; inset:0; pointer-events:none; z-index:200; opacity:0; transition:opacity .2s; }
#dim { background:#000; }
#warm { background:#ff9a2e; mix-blend-mode:multiply; }
.eyr { width:100%; accent-color:var(--accent); margin:2px 0 8px; }
.eyl { display:flex; justify-content:space-between; font-weight:500; font-size:13px; margin-top:6px; }

/* ---------- Drawer ---------- */
#back { position:fixed; inset:0; background:#0006; z-index:30; }
#drawer { position:fixed; top:0; bottom:0; left:0; width:min(92vw,400px); background:var(--bar); z-index:31;
  display:flex; flex-direction:column; box-shadow:2px 0 16px #0004; padding-top:env(safe-area-inset-top,0px); }
#drawer.right { left:auto; right:0; box-shadow:-2px 0 16px #0004; }
#dHead { display:flex; align-items:center; justify-content:space-between; padding:8px 8px 8px 14px; border-bottom:1px solid var(--line); font-size:16px; }
#dBody { overflow:auto; padding:12px 14px calc(20px + env(safe-area-inset-bottom,0px)); flex:1; -webkit-overflow-scrolling:touch; }
#dBody input[type=search] { width:100%; padding:10px 12px; border:1px solid var(--line); border-radius:6px; background:var(--bg); color:var(--text); font:inherit; margin-bottom:10px; }
.btn { color:var(--text); background:none; border:1px solid var(--line); border-radius:8px; padding:8px 12px; font:inherit; text-decoration:none; cursor:pointer; min-height:36px;
  display:inline-flex; align-items:center; justify-content:center; gap:6px; }
.cat { margin:16px 0 4px; font-size:12px; opacity:.7; display:flex; justify-content:space-between; align-items:center; }
.cat button { font:inherit; font-size:12px; color:var(--accent); background:none; border:0; cursor:pointer; padding:2px 4px; }
.li { display:block; padding:11px 8px; border-radius:6px; color:var(--text); text-decoration:none; font-weight:500; border-top:1px solid var(--line); }
.li small { display:block; opacity:.7; font-weight:600; font-size:11px; margin-top:3px; }
.li.on { background:var(--accent); color:var(--onacc); }
.mini { height:3px; background:var(--line); border-radius:2px; margin-top:6px; overflow:hidden; }
.mini i { display:block; height:100%; background:var(--accent); }
.li.on .mini i { background:var(--onacc); }
.srow { display:flex; align-items:stretch; border-top:1px solid var(--line); }
.srow .li { flex:1; border-top:0; min-width:0; }
.srow .del { background:none; border:0; padding:0 12px; cursor:pointer; opacity:.7; }
.chips { display:flex; flex-wrap:wrap; gap:6px; padding:8px 0; }
.chip { min-width:40px; text-align:center; padding:8px 10px; border:1px solid var(--line); border-radius:6px; color:var(--text); text-decoration:none; cursor:pointer; background:none; font:inherit; }
.chip.on { background:var(--accent); color:var(--onacc); border-color:var(--accent); }
.ni { border:1px solid var(--line); border-radius:8px; padding:10px 12px; margin:8px 0; font-weight:500; cursor:pointer; }
.ni small { display:block; opacity:.7; font-weight:600; margin-bottom:4px; }
.ni q, .ni .t { display:block; border-left:4px solid var(--c,#ffe14d); padding-left:8px; margin:4px 0; }
.ni .n { margin-top:4px; }
.tools { display:flex; gap:6px; flex-wrap:wrap; margin-bottom:8px; }
.chk { display:flex; gap:8px; align-items:center; font-weight:500; margin:6px 0 4px; }
.sh { margin:16px 0 6px; font-size:12px; opacity:.7; }
.seg { display:flex; border:1px solid var(--line); border-radius:8px; overflow:hidden; }
.seg button { flex:1; background:none; border:0; border-right:1px solid var(--line); padding:10px 4px; cursor:pointer; font-size:13px; }
.seg button:last-child { border-right:0; }
.seg button[aria-pressed="true"] { background:var(--accent); color:var(--onacc); }
.zrow { display:flex; gap:6px; align-items:center; }
.zrow .btn { flex:1; }

/* ---------- Editor ---------- */
#ed { position:fixed; inset:0; background:#0006; z-index:40; display:none; align-items:center; justify-content:center; padding:16px; }
#ed.show { display:flex; }
#edBox { background:var(--bar); border:1px solid var(--line); border-radius:12px; padding:16px; width:min(100%,460px); max-height:90vh; overflow:auto; }
#edQ { margin:0 0 10px; padding-left:10px; border-left:4px solid var(--accent); font-weight:500; max-height:120px; overflow:auto; }
#edT { width:100%; min-height:100px; padding:10px; border:1px solid var(--line); border-radius:6px; background:var(--bg); color:var(--text); font:500 15px/1.5 Inter, sans-serif; resize:vertical; }
#edC { display:flex; gap:8px; margin:10px 0; }
#edC .sw { width:34px; height:34px; border-radius:50%; padding:0; border:2px solid var(--line); cursor:pointer; background-clip:padding-box; }
#edC .sw.on { border-color:var(--text); }
.acts { display:flex; gap:8px; justify-content:flex-end; margin-top:12px; }
#edBox button.b { background:none; border:1px solid var(--line); border-radius:6px; padding:9px 14px; font:inherit; cursor:pointer; }
#edBox .primary { background:var(--accent); color:var(--onacc); border-color:var(--accent); }

/* ---------- Google Drive mode ---------- */
body.drive { height:100vh; height:100dvh; display:flex; flex-direction:column; overflow:hidden; }
body.drive .bar { position:relative; transform:none; flex:none; }
body.drive #pages, body.drive #pill, body.drive #progress, body.drive .dock, body.drive #book, body.drive .rail, body.drive #opts, body.drive .edge, body.drive .brk { display:none !important; }
#frame { flex:1; width:100%; min-height:0; border:0; background:var(--bg); }
#note { display:none; padding:6px 12px; font-size:12px; font-weight:500; background:var(--bar); border-bottom:1px solid var(--line); text-align:center; flex:none; }
body.drive #note { display:block; }

body.penonly .pg{touch-action:pan-y pinch-zoom}
body.railoff .rail, body.railoff .brk { display:none !important; }
#railBtn { order:7; }
@media (max-width:640px) { #railBtn { order:5; } }
body.annoff .hl, body.annoff .ink, body.annoff .pins { display:none !important; }
/* Short landscape: the controls float over the page so the book gets the full height */
@media (orientation:landscape) and (max-height:500px) {
  #note { display:none !important; }
  #book { padding:6px 8px; }
  .rail button { height:34px; }
}
</style>
</head>
<body>

<header class="bar" id="bar">
  <a class="ib" href="./index.html" aria-label="Home" data-i="home"></a>
  <button class="ib" id="libBtn" type="button" aria-label="Library" data-i="book"></button>
  <div class="title" id="title">Loading book…</div>
  <button class="ib" id="searchBtn" type="button" aria-label="Search in this book" data-i="search"></button>
  <button class="ib" id="notesBtn" type="button" aria-label="Notes, comments and bookmarks" data-i="list"><span id="cnt" hidden>0</span></button>
  <button class="ib" id="setBtn" type="button" aria-label="Reading settings" data-i="sliders"></button>
  <button class="ib" id="railBtn" type="button" aria-label="Show or hide toolbar icons" title="Show / hide toolbar icons" data-i="grid"></button>
  <span class="brk"></span>
  <div class="rail" id="tools" role="toolbar" aria-label="Annotation tools">
    <button type="button" data-tool="select" aria-label="Read and select text" title="Read / select text (V)" data-i="cursor"></button>
    <span class="rsep"></span>
    <button type="button" data-tool="hl" aria-label="Highlighter" title="Highlighter (H)" data-i="hl"><i class="dot"></i></button>
    <button type="button" data-tool="pen" aria-label="Pen" title="Pen (P)" data-i="pen"><i class="dot"></i></button>
    <button type="button" data-tool="erase" aria-label="Eraser" title="Eraser (E)" data-i="erase"></button>
    <button type="button" data-tool="pin" aria-label="Add comment" title="Comment (C)" data-i="comment"></button>
    <span class="rsep"></span>
    <button type="button" data-act="undo" aria-label="Undo last drawing" title="Undo" data-i="undo"></button>
    <button type="button" data-act="vis" aria-label="Show or hide all marks" title="Show / hide all highlights, drawings and comments" data-i="eye"></button>
  </div>
  <div id="progress" aria-hidden="true"><div id="progressBar"></div></div>
</header>

<div id="opts" hidden></div>

<div id="note">This book opens in Google Drive's viewer, so highlights and drawing are not available here. Download it, then use Library → Open a PDF from this device to annotate it. You can still add page notes.</div>

<div id="msg" role="status" aria-live="polite">Opening book…</div>
<div id="pages"></div>
<div id="book" hidden></div>
<button class="edge l" id="eL" type="button" aria-label="Previous page" data-i="chevL"></button>
<button class="edge r" id="eR" type="button" aria-label="Next page" data-i="chevR"></button>
<div id="pill" aria-hidden="true"></div>

<div id="sel" role="toolbar" aria-label="Annotate selected text">
  <button class="sw" data-c="#ffe14d" style="background:#ffe14d" aria-label="Highlight yellow"></button>
  <button class="sw" data-c="#7ee08a" style="background:#7ee08a" aria-label="Highlight green"></button>
  <button class="sw" data-c="#8ec5ff" style="background:#8ec5ff" aria-label="Highlight blue"></button>
  <button class="sw" data-c="#ff9ec4" style="background:#ff9ec4" aria-label="Highlight pink"></button>
  <button id="selU" type="button" style="text-decoration:underline" aria-label="Underline">U</button>
