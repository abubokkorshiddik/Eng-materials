  }
  $("ribToggle").addEventListener("click", () => setRib(!ribOff));
  document.querySelector(".tabs").addEventListener("dblclick", e => { if (e.target.closest("[data-tab]")) setRib(!ribOff); });
  setRib(ribOff);

  /* ---------- Pictures: drop, and drag handle to resize ---------- */
  doc.addEventListener("dragover", e => { if (e.dataTransfer && [...e.dataTransfer.types].includes("Files")) e.preventDefault(); });
  doc.addEventListener("drop", e => {
    const fs = [...((e.dataTransfer && e.dataTransfer.files) || [])].filter(f => /^image\//.test(f.type)); if (!fs.length) return;
    e.preventDefault();
    let r = null;
    if (document.caretRangeFromPoint) r = document.caretRangeFromPoint(e.clientX, e.clientY);
    else if (document.caretPositionFromPoint) { const p = document.caretPositionFromPoint(e.clientX, e.clientY); if (p) { r = document.createRange(); r.setStart(p.offsetNode, p.offset); } }
    if (r) { const s = getSelection(); s.removeAllRanges(); s.addRange(r); saveSel(); }
    fs.forEach(insertImageFile);
  });
  const rsz = $("rsz"); let rszDrag = null;
  function placeRsz() {
    if (!ctxEl || ctxEl.tagName !== "IMG" || ctx.hidden) { rsz.hidden = true; return; }
    const r = ctxEl.getBoundingClientRect(); rsz.style.left = (r.right - 9) + "px"; rsz.style.top = (r.bottom - 9) + "px"; rsz.hidden = false;
  }
  rsz.addEventListener("pointerdown", e => {
    if (!ctxEl) return; e.preventDefault(); rsz.setPointerCapture(e.pointerId);
    const r = ctxEl.getBoundingClientRect(); rszDrag = { x: e.clientX, w: ctxEl.offsetWidth, sc: r.width / ctxEl.offsetWidth || 1 };
  });
  rsz.addEventListener("pointermove", e => {
    if (!rszDrag) return;
    ctxEl.style.width = Math.max(30, Math.round(rszDrag.w + (e.clientX - rszDrag.x) / rszDrag.sc)) + "px"; ctxEl.style.height = "auto"; placeRsz(); reposition();
  });
  rsz.addEventListener("pointerup", () => { if (rszDrag) { rszDrag = null; changed(); } });

  /* ---------- Start ---------- */
  function page_w() { return pageDims().w + 24; }

  /* Quotes sent from the Reader arrive here as block quotes with a citation */
  function takeInbox() {
    let box = []; try { box = JSON.parse(store.get("winbox") || "[]"); } catch (e) {}
    if (!Array.isArray(box) || !box.length) return;
    store.set("winbox", "[]");
    try { srcs = JSON.parse(store.get("wlib") || "[]"); } catch (e) {}
    if (!doc.textContent.trim() && !doc.querySelector("img,table")) doc.innerHTML = "";
    box.forEach(i => {
      doc.insertAdjacentHTML("beforeend", "<blockquote>“" + esc(i.text) + "” " + '<span class="cite" data-id="' + esc(i.src) + '" contenteditable="false">(…)</span>' +
        (i.p ? " p. " + esc(i.p) : "") + (i.note ? "<br><i>Note: " + esc(i.note) + "</i>" : "") + "</blockquote>");
    });
    doc.insertAdjacentHTML("beforeend", "<p><br></p>");
    refreshRefs(true); toast(box.length + (box.length === 1 ? " quote" : " quotes") + " added from the Reader");
  }
  function start() {
    if (!(cid && loadDoc(cid))) applyPage();
    if (innerWidth < page_w()) fitWidth(); else setZoom(1);
    takeInbox();
    window.addEventListener("focus", takeInbox);
    resetHist(); layout(); doc.focus();
  }
  loadAllDocs().catch(() => {}).then(start);
})();
</script>
</body>
